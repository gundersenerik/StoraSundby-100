# Supabase
# Projekt: storasundby-100, region eu-north-1 (Stockholm), Free.
# URL och publishable key ar inte hemligheter - de skickas till webblasaren
# och skyddas av Row Level Security. Service role-nyckeln ar en hemlighet och
# far aldrig na klienten.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-post
RESEND_API_KEY=

# Swish Handel (lamnas tomma tills bankavtalet ar klart)
SWISH_PAYEE_ALIAS=
SWISH_CERT_PATH=
SWISH_CERT_PASSPHRASE=
SWISH_CALLBACK_IDENTIFIER=

# Stripe (alternativ betalvag)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Uthyrning
# Nyckeln som skyddar kansliets iCal-feed (/api/uthyrning/kalender?nyckel=...).
# Feeden innehaller gastuppgifter och ar avstangd tills nyckeln ar satt.
# Valfri lang slumpstrang, t.ex. `openssl rand -hex 24`.
UTHYRNING_ICAL_NYCKEL=

# Cron-jobbens nyckel. Vercel skickar automatiskt Authorization-headern till
# schemalagda anrop nar variabeln finns. Paminnelserutten ar avstangd utan den.
CRON_SECRET=
